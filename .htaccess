# Apache .htaccess for SPAK Metaal Craft
# Place in document root (public_html or /var/www/html)
# Requires: mod_headers, mod_deflate, mod_expires, mod_rewrite, mod_setenvif

# ============================================
# SECURITY HEADERS
# ============================================
<IfModule mod_headers.c>
    # Prevent clickjacking
    Header always set X-Frame-Options "DENY"

    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Control referrer information
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Disable unused browser features
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"

    # Content Security Policy
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.gstatic.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

    # HSTS (enable only after confirming HTTPS works)
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Remove server signature
    Header unset Server
    Header unset X-Powered-By
</IfModule>

# ============================================
# COMPRESSION (Gzip/Deflate)
# ============================================
<IfModule mod_deflate.c>
    # Enable compression
    SetOutputFilter DEFLATE

    # Compress specific MIME types
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml application/rss+xml application/atom+xml
    AddOutputFilterByType DEFLATE image/svg+xml application/x-font-ttf application/x-font-opentype font/opentype font/ttf font/eot font/otf

    # Don't compress images (already compressed)
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|avif|ico|svg|woff|woff2)$ no-gzip dont-vary

    # Handle proxies
    Header append Vary User-Agent env=!dont-vary
</IfModule>

# ============================================
# BROTLI COMPRESSION (if mod_brotli available)
# ============================================
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json application/xml application/rss+xml application/atom+xml
    AddOutputFilterByType BROTLI_COMPRESS image/svg+xml application/x-font-ttf application/x-font-opentype font/opentype font/ttf font/eot font/otf
</IfModule>

# ============================================
# CACHING (Expires Headers)
# ============================================
<IfModule mod_expires.c>
    ExpiresActive On

    # Default cache: 1 hour
    ExpiresDefault "access plus 1 hour"

    # Static assets: 1 year
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/x-font-ttf "access plus 1 year"
    ExpiresByType application/x-font-opentype "access plus 1 year"

    # CSS/JS: 1 year (use filename versioning for cache busting)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # HTML: No cache (always revalidate)
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ============================================
# CACHE-CONTROL HEADERS (more granular)
# ============================================
<IfModule mod_headers.c>
    # Static assets: long-term cache, immutable
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico|woff|woff2|ttf|eot|otf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # CSS/JS: long-term cache
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # HTML: short cache, must revalidate
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>

    # ETags for efficient revalidation
    FileETag MTime Size
</IfModule>

# ============================================
# URL REWRITES & SECURITY
# ============================================
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS (uncomment after SSL is configured)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Remove www (or enforce www - choose one)
    # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    # RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # Block access to hidden files and directories
    RewriteRule "(^|/)\." - [F]

    # Block access to backup, config, log files
    RewriteRule "\.(bak|backup|conf|config|log|sql|md|gitignore|gitattributes)$" - [F]

    # Block access to sensitive directories
    RewriteRule "^(images|css|js)/.*\.(php|pl|py|jsp|asp|sh|cgi)$" - [F]

    # Prevent directory listing
    Options -Indexes
</IfModule>

# ============================================
# MIME TYPES
# ============================================
<IfModule mod_mime.c>
    # Fonts
    AddType font/woff .woff
    AddType font/woff2 .woff2
    AddType application/font-woff .woff
    AddType application/font-woff2 .woff2
    AddType application/x-font-ttf .ttf
    AddType application/x-font-opentype .otf

    # Images
    AddType image/webp .webp
    AddType image/avif .avif
    AddType image/svg+xml .svg

    # JavaScript modules
    AddType application/javascript .js .mjs
</IfModule>

# ============================================
# PERFORMANCE: Keep-Alive
# ============================================
<IfModule mod_headers.c>
    Header set Connection keep-alive
</IfModule>

# ============================================
# ERROR PAGES (optional)
# ============================================
# ErrorDocument 404 /404.html
# ErrorDocument 500 /500.html

# ============================================
# PHP SETTINGS (if PHP is used)
# ============================================
# php_value upload_max_filesize 10M
# php_value post_max_size 10M
# php_value max_execution_time 30
# php_value max_input_time 60
# php_flag display_errors Off
# php_flag log_errors On
# php_value error_log /var/log/php_errors.log